{
  "name": "@spinejit/pi-spinejit",
  "version": "0.1.1",
  "type": "module",
  "license": "Apache-2.0",
  "author": "GhabiX",
  "description": "SpineJIT context management for Pi, backed by the portable Spine SDK.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GhabiX/spine-plugin.git",
    "directory": "packages/plugin"
  },
  "bugs": {
    "url": "https://github.com/GhabiX/spine-plugin/issues"
  },
  "homepage": "https://github.com/GhabiX/spine-plugin#readme",
  "keywords": [
    "pi-package",
    "spinejit"
  ],
  "pi": {
    "extensions": [
      "./dist/pi/extension.js"
    ]
  },
  "exports": {
    "./pi/tree-view": {
      "types": "./dist/pi/tree-view-contract.d.ts",
      "import": "./dist/pi/tree-view-contract.js"
    },
    "./pi": {
      "types": "./dist/pi/index.d.ts",
      "import": "./dist/pi/index.js"
    },
    "./pi/extension": {
      "types": "./dist/pi/extension.d.ts",
      "import": "./dist/pi/extension.js"
    },
    "./pi/tree-style": {
      "types": "./dist/pi/tree-style.d.ts",
      "import": "./dist/pi/tree-style.js"
    }
  },
  "files": [
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@spinejit/spine-host": "0.1.0",
    "@spinejit/spine-sdk": "0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "typebox": "1.3.27"
  }
}
