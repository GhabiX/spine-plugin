{
  "name": "@spinejit/spine-sdk",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "author": "GhabiX",
  "description": "Portable SpineJIT protocol and Node WASM runtime.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GhabiX/spine-plugin.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/GhabiX/spine-plugin/issues"
  },
  "homepage": "https://github.com/GhabiX/spine-plugin#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "README.md",
    "dist",
    "wasm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:wasm-node": "sh ../../scripts/build-node-wasm.sh",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  }
}
