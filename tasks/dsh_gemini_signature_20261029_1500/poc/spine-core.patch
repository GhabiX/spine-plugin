+/// A task node's descriptor, an entry at the boundary where the node opened.
+fn descriptor(node_id: &NodeId, summary: &str) -> NodeEntry {
+    NodeEntry::Leaf(ContextItem::SyntheticNode {
+        node_id: node_id.clone(),
+        summary: summary.to_string(),
+        status: NodeStatus::Opened,
+    })
