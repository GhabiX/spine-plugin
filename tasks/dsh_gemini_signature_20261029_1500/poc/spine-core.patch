+#[test]
+fn a_sampled_item_keeps_the_context_it_was_sampled_in() {
+    // Every sampling stays after exactly the context it saw: a descriptor
+    // follows the sampling that opened its node, and the sampling that closes
+    // a node folds with it.
+    let mut history = History::new("sampling-boundary");
+    history.user("outer request");
+    history.step(open("P"));
+    assert_eq!(
+        plan_shape(&history),
+        vec!["source [UserAnchor(1)]", "source", "projection node 1.1"]
+    );
+    history.step(open("Q"));
+    assert_eq!(
+        plan_shape(&history),
+        vec![
+            "source [UserAnchor(1)]",
+            "source",
+            "projection node 1.1",
+            "source",
+            "projection node 1.1.1"
+        ]
+    );
+    history.step(next("Q memory", "R"));
+    assert_eq!(
+        plan_shape(&history),
+        vec![
+            "source [UserAnchor(1)]",
+            "source",
+            "projection node 1.1",
+            "projection summary",
+            "projection node 1.1.2"
+        ]
+    );
+    history.step(close("R memory"));
+    history.step(close("P memory"));
+    // P's memory: its own summary, then Q's and R's.
+    assert_eq!(
+        plan_shape(&history),
+        vec![
+            "source [UserAnchor(1)]",
+            "projection summary",
+            "projection summary",
+            "projection summary"
+        ]
+    );
+    history.replay();
+}
