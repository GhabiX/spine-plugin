+
+    let mut history = History::new("arrival-unknown");
+    history.step(open("P"));
+    history.arrival(&[1, 1], SpawnOutcome::Completed, Some("memory"));
+    let error = history
+        .runtime
+        .preview_context_plan()
+        .expect_err("not a birth");
+    assert!(error.to_string().contains("not a birth"), "{error}");
+}
